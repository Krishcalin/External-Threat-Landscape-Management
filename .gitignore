# NOT ignored, deliberately: data/kev.json and data/epss.json.
# The intelligence corpus is a VERSIONED INPUT, not a build artefact — a scan
# records which catalogue version answered it, and that is only reproducible if
# the corpus is in the repository. See tools/refresh_intel.py.

# Output of frontend/scripts/render-check.tsx
frontend/.render-check/

# TAXII poll cursors. Per-deployment RUNTIME STATE, not a vendored corpus:
# it records how far this installation has polled somebody else's server.
# Committing it would hand every clone a cursor from a machine that is not
# theirs, and the first poll would silently skip everything before it.
data/taxii_state.json
