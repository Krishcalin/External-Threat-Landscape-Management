# Copy to .env and set a real value. .env is gitignored.
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# How often the opt-in scheduler runs the daily jobs, in seconds. Only read by
# the `scheduler` profile, which is off unless you start it explicitly:
#
#     docker compose --profile scheduler up -d
#
# It makes outbound requests to FIRST every day without further prompting, so
# starting it is a decision rather than a default. Leaving it off is also a
# decision with a cost: EPSS never republishes a past day, so each day it does
# not run is a hole no later effort can fill.
SKOPOS_SCHEDULE_SECONDS=86400

# Bearer token for the two routes that serve finished reconnaissance: the
# takeover list and the TAXII 2.1 server at /taxii2/. UNSET IS THE SAFE STATE —
# neither route is registered without it, rather than registered and returning
# 401, because a 401 that can be probed is still an admission the data exists.
#
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
SKOPOS_API_TOKEN=

# Alert delivery. With neither set, alerts are computed and not delivered, and
# every response says so rather than leaving it to be discovered.
SKOPOS_ALERT_WEBHOOK=
SKOPOS_ALERT_EMAIL=
SKOPOS_SMTP_HOST=
SKOPOS_SMTP_PORT=587
SKOPOS_SMTP_FROM=
SKOPOS_SMTP_USER=
SKOPOS_SMTP_PASSWORD=

# Set to 1 to have a scan run DELIVER its alerts through whatever is configured
# above. Off by default: a scan is an action somebody took, but describing your
# estate to a third party is a second act and needs its own consent.
SKOPOS_ALERT_ON_SCAN=

# The first administrator. Applied ONCE against an empty user table and ignored
# thereafter, so re-running with these still set cannot silently reset a
# password somebody has since changed.
#
# Until a user exists the console is OPEN, and says so on /health and across the
# top of every page. Authentication enforces itself the moment one is created —
# there is deliberately no default credential and no enable flag to forget.
#
# The password must be at least 12 characters. Composition rules are not
# imposed: a length floor is the only password rule with good evidence behind it.
SKOPOS_BOOTSTRAP_USER=
SKOPOS_BOOTSTRAP_PASSWORD=

# ── licensed sources ───────────────────────────────────────────────────────
# Each is OFF until its key is set, and a lookup running without one reports it
# as unavailable rather than returning a clean result. Terms are the operator's
# to accept, not this product's.
#
# Shodan is the only passive route to OPEN PORTS AND SERVICES for a target whose
# ownership cannot be proven — SKOPOS may not probe it, so a third party who
# already scanned it is the sole option. Without this key, "no ports shown"
# means "not looked at", and the response says so.
SKOPOS_SHODAN_API_KEY=
# VirusTotal: engine detections and reputation for a name. An observation by a
# named vendor on a date, never a verdict and never an attribution.
SKOPOS_VIRUSTOTAL_API_KEY=
# Have I Been Pwned: whether an address appears in a published breach corpus.
# Never a statement that an account is compromised now.
SKOPOS_HIBP_API_KEY=
