# Copy to .env and set a real value. .env is gitignored.
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# How often the opt-in scheduler runs the daily jobs, in seconds. Only read by
# the `scheduler` profile, which is off unless you start it explicitly:
#
#     docker compose --profile scheduler up -d
#
# It makes outbound requests to FIRST every day without further prompting, so
# starting it is a decision rather than a default. Leaving it off is also a
# decision with a cost: EPSS never republishes a past day, so each day it does
# not run is a hole no later effort can fill.
SKOPOS_SCHEDULE_SECONDS=86400
